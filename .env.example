# ==============================================================================
# Galla Environment Variables Template
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
# ==============================================================================

# MongoDB Atlas Connection String
# Must include database name, credentials, and query params
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/galla?retryWrites=true&w=majority"

# NextAuth / Auth.js Configuration
# Generate a secure secret using: openssl rand -base64 32 (or npx auth secret)
AUTH_SECRET="replace-with-a-secure-random-secret-key-at-least-32-chars"
NEXTAUTH_SECRET="replace-with-a-secure-random-secret-key-at-least-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# Pusher Channels Configuration (Realtime Updates)
PUSHER_APP_ID="your_pusher_app_id"
PUSHER_SECRET="your_pusher_secret"
NEXT_PUBLIC_PUSHER_KEY="your_pusher_key"
NEXT_PUBLIC_PUSHER_CLUSTER="ap2"

# Cloudinary Configuration (Salon Profile Images)
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# App Environment
NODE_ENV="development"
